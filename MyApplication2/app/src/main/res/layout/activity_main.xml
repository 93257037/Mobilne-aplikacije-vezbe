<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- EditText 1: triggers camera when "kamera" is typed, or fetches comment by number -->
    <EditText
        android:id="@+id/editText1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unesite 'kamera' ili broj komentara"
        android:inputType="text"
        android:imeOptions="actionDone" />

    <!-- EditText 2: shows comment text / location / accelerometer -->
    <EditText
        android:id="@+id/editText2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Rezultat"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:gravity="top"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:cursorVisible="false" />

    <!-- ImageView: shows photo taken by camera -->
    <ImageView
        android:id="@+id/imageViewPhoto"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        android:background="#E0E0E0"
        android:contentDescription="Captured photo" />

    <!-- Checkbox: controls sound playback -->
    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Reprodukuj zvuk" />

    <!-- Switch: on = repeat, off = once -->
    <Switch
        android:id="@+id/switchRepeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ponavljaj zvuk" />

</LinearLayout>
